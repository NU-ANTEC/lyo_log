# Copy to .env, chmod 600 .env, and configure before starting services.
# Blank optional values use defaults; use explicit false to disable a boolean.
# Select exactly one: freezone, stoppering_combined, stoppering_direct.
LABCONCO_STYLE=freezone
INSTRUMENT_NAME="Freeze dryer"

# Filesystem paths are relative to the project, NOT the current working directory.
LOG_DIRECTORY=./data
# Blank means LOG_DIRECTORY; keep plots inside RCLONE_SOURCE if uploading them.
PNG_DIRECTORY=
ALERT_FLAG_FILE=./state/alert_active.flag
ALERT_LOG_FILE=./state/alerts.log

# Prefer a stable /dev/serial/by-id/... path on each Pi.
SERIAL_PORT=/dev/ttyUSB0
# All supported modes default to 2400 baud, 8N1. Blank uses that default.
SERIAL_BAUDRATE=
SERIAL_TIMEOUT_SECONDS=1
SERIAL_RECOVERY_ENABLED=true
# Match the transmission interval configured on the instrument (10–600 seconds).
SERIAL_EXPECTED_INTERVAL_SECONDS=10
# Must exceed the actual transmission interval, with a generous margin.
SERIAL_IDLE_TIMEOUT_SECONDS=120
# Failed reopens only: the original stalled connection is not counted.
SERIAL_REOPEN_ATTEMPTS=3
SERIAL_RETRY_INITIAL_SECONDS=1
SERIAL_RETRY_MAX_SECONDS=30

# Optional adapter-only reset. See docs/DEPLOYMENT.md for exact-device permissions.
USB_RESET_ENABLED=false
USB_VENDOR_ID=
USB_PRODUCT_ID=
USB_SERIAL_NUMBER=
USB_RESET_MIN_INTERVAL_SECONDS=600

PLOT_INTERVAL_SECONDS=60
PLOT_WIDTH_INCHES=10
PLOT_HEIGHT_INCHES=6
PRESSURE_MIN_UBAR=5
PRESSURE_MAX_UBAR=5000
TEMPERATURE_MIN_C=-90
TEMPERATURE_MAX_C=40

# Choose thresholds appropriate for the instrument; pressure is in µbar.
# Direct tray: pressure-only in every state (including STNDBY), no duration delay.
# Base/combined: legacy pressure + collector-temperature policy; see deployment guide.
ALERTS_ENABLED=false
# Applies to base/combined alarms only; ignored for the direct pressure alarm.
ALERT_DURATION_HOURS=0.25
PRESSURE_THRESHOLD=
# Required for base/combined alarms; may remain blank in stoppering_direct mode.
TEMPERATURE_THRESHOLD=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Copy only; authentication remains in rclone's own protected configuration.
UPLOAD_ENABLED=false
RCLONE_EXECUTABLE=rclone
# Blank means LOG_DIRECTORY. Destination uses rclone's remote:path syntax.
RCLONE_SOURCE=
RCLONE_DESTINATION=

# Zero disables deletion. Positive values purge dated raw logs at startup.
DATA_RETENTION_DAYS=0
# Routine records/plot refreshes are not logged at INFO.
LOG_LEVEL=INFO
