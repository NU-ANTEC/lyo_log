[Unit]
Description=Lyophilizer plot monitor
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=/opt/lyo_log
ExecStart=/opt/lyo_log/.venv/bin/python -u /opt/lyo_log/generate_png.py
Restart=on-failure
RestartSec=3s
User=lyolog
Group=lyolog
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
